{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "test": "deno run -A npm:vitest run",
    "check": "deno check src/ vite.config.ts && deno check --config backend/deno.json backend/main.ts",
    "serve": "deno run -A --watch backend/main.ts --port 8787",
    "vendor-dimos-react": "deno run -A --no-lock tools/vendor_dimos_react.ts",
    "update-hashes": "deno run -A scripts/update_hashes.ts"
  },
  "imports": {
    "react": "npm:react@^19.2.0",
    "react/": "npm:/react@^19.2.0/",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/": "npm:/react-dom@^19.2.0/",
    "@dimos/msgs/": "jsr:/@dimos/msgs@^0.1.4/",
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.0",
    "happy-dom": "npm:happy-dom@^20.11.1",
    "vite": "npm:vite@^7.1.0",
    "vitest": "npm:vitest@^3.2.4"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "dist/",
      "icon.svg",
      "dimos.yaml",
      "src/dim-app/",
      "src/vendor/dimos-react/"
    ]
  },
  "lint": {
    "exclude": [
      "dist/",
      "src/dim-app/",
      "src/vendor/dimos-react/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
