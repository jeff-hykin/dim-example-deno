{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "test": "deno run -A npm:vitest run",
    "check": "deno run -A npm:typescript/tsc --noEmit && deno check backend/main.ts",
    "serve": "deno run -A --watch backend/main.ts --port 8787"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["dist/", "icon.svg", "dimos.yaml"]
  },
  "lint": {
    "exclude": ["dist/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
